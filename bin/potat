#!/usr/bin/env ruby
require_relative '../lib/potato'

VERSION = "0.0.0"

if ARGV.include?("--version") || ARGV.include?("-v")
  puts "Potato Lang #{VERSION} 🥔"
  exit
end

path = ARGV.find { |a| !a.start_with?("-") } || "./main.potato"
options = { ast: ARGV.include?("--ast"), scope: ARGV.include?("--scope"), ir: ARGV.include?("--ir"), no_cache: ARGV.include?("--no-cache") }
begin
  Potato.run_file(path, options)
rescue RuntimeError => e
  warn e.message
  exit 1
end